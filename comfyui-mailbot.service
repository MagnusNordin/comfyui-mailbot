[Unit]
Description=ComfyUI Mail Bot
After=network.target comfyui.service
Wants=comfyui.service

[Service]
Type=simple
User=magnor
WorkingDirectory=/home/magnor/comfyui-mailbot
# Without this, print() output sits in a buffer and never reaches the journal.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/magnor/comfyui-mailbot/venv/bin/python mail_to_comfyui.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
