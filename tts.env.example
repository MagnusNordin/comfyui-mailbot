# TTS mailbox. Copy this to tts.env in the same folder and fill in real values.
# Keep it locked down: chmod 600 tts.env

IMAP_HOST=imap.one.com
IMAP_PORT=993
SMTP_HOST=send.one.com
SMTP_PORT=465

EMAIL_USER=tts-bot@example.com
EMAIL_PASS=

# Comma-separated list of sender addresses allowed to trigger a render.
ALLOWED_SENDERS=you@example.com

COMFYUI_URL=http://127.0.0.1:8188

OUTPUT_KIND=audio

# Export the TTS workflow from ComfyUI via Workflow -> Export (API format).
WORKFLOW_PATH=/home/magnor/ComfyUI/workflows/tts_api.json

# Node that takes the text to speak, and the name of its text input
# (look at that node's "inputs" in the exported JSON - often "text").
POSITIVE_NODE_ID=CHANGE_ME
PROMPT_INPUT_NAME=text

# The Save Audio / Save Audio (MP3) node. MP3 plays inline in more mail
# clients than FLAC, so prefer SaveAudioMP3 in the workflow if available.
SAVE_IMAGE_NODE_ID=CHANGE_ME

# Long texts take a while to synthesize.
RENDER_TIMEOUT_SECONDS=900
PROCESSED_FOLDER=Processed
