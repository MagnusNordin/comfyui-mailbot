# TTS mailbox. Copy this to tts.env in the same folder and fill in real values.
# Keep it locked down: chmod 600 tts.env

IMAP_HOST=imap.one.com
IMAP_PORT=993
SMTP_HOST=send.one.com
SMTP_PORT=465

EMAIL_USER=tts-bot@example.com
EMAIL_PASS=

# Comma-separated list of sender addresses allowed to trigger a render.
ALLOWED_SENDERS=you@example.com

COMFYUI_URL=http://127.0.0.1:8188

OUTPUT_KIND=audio

# Chatterbox multilingual TTS (Swedish), exported via Workflow -> Export (API
# format). Its Load Audio node (4) clones the voice from a sample file that
# must exist in ComfyUI/input.
WORKFLOW_PATH=/home/magnor/comfyui-mailbot/workflows/chatterbox_tts_api.json

# Node that takes the text to speak (FL_ChatterboxMultilingualTTS), and the
# name of its text input.
POSITIVE_NODE_ID=2
PROMPT_INPUT_NAME=text

# Load Audio node with the voice sample. The email subject picks the voice:
# "anna" uses anna.wav (any audio file in ComfyUI/input, matched by name
# without extension, ignoring case). Empty/unknown subject = the workflow's
# default. Remove this line to always use the default.
VOICE_NODE_ID=4

# Node whose seed gets a new random value for every email, so resending the
# same text gives a new take (e.g. if a clip has odd sounds). Remove this
# line to always use the workflow's fixed seed.
SEED_NODE_ID=2

# The Save Audio (Advanced) node. It is set to MP3, which plays inline in
# more mail clients than FLAC.
SAVE_IMAGE_NODE_ID=3

# Long texts take a while to synthesize.
RENDER_TIMEOUT_SECONDS=900
PROCESSED_FOLDER=Processed
