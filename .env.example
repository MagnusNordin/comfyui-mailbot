# Copy this to .env in the same folder and fill in real values.
# Keep .env permissions locked down: chmod 600 .env

IMAP_HOST=imap.one.com
IMAP_PORT=993
SMTP_HOST=send.one.com
SMTP_PORT=465

EMAIL_USER=bot@example.com
EMAIL_PASS=

# Comma-separated list of sender addresses allowed to trigger a render.
# Leave blank to allow anyone who emails this address (not recommended).
ALLOWED_SENDERS=you@example.com

COMFYUI_URL=http://127.0.0.1:8188

# Export your workflow from ComfyUI via the menu: Workflow -> Export (API format)
# and point this at the resulting JSON file.
WORKFLOW_PATH=/home/magnor/ComfyUI/workflows/sdxl_portrait_api.json

# Node IDs from that exported JSON (open it in a text editor to find them --
# each node is a numbered key, and its "class_type" tells you what it is).
POSITIVE_NODE_ID=6
NEGATIVE_NODE_ID=7
SAVE_IMAGE_NODE_ID=9

DEFAULT_NEGATIVE_PROMPT=blurry, distorted, extra limbs, bad anatomy, low quality
RENDER_TIMEOUT_SECONDS=300
PROCESSED_FOLDER=Processed
